{
  "name": "aimlockr-client",
  "version": "0.1.0",
  "private": true,
  "description": "Electron client for kirka.io with fullscreen, uncapped FPS, and an in-game menu",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "vite build --config vite.main.config.js",
    "build:preload": "vite build --config vite.preload.config.js",
    "build:ui": "vite build --config vite.ui.config.js",
    "build": "npm run build:main && npm run build:preload && npm run build:ui",
    "dev": "npm run build && node scripts/assemble-win.js --launch",
    "dist:win": "npm run build && node scripts/assemble-win.js",
    "clean": "rm -rf dist out",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && node scripts/assemble-win.js && node scripts/package-win.js"
  },
  "dependencies": {
    "effect": "^4.1.3",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^22.0.0",
    "electron": "44.0.0",
    "eslint": "^10.0.2",
    "globals": "^16.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
